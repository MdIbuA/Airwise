# Copy to .env (never commit .env). Without a key AirWise runs in rule-based mode.

# Google Gemini (default AI provider)
GEMINI_API_KEY=
# Optional second key: used automatically if the primary is rejected, rate-limited or down.
GEMINI_API_KEY_BACKUP=

# Or use Claude instead (picked automatically if no Gemini key is set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_BACKUP=

PORT=8080
# Optional tuning
# AIRWISE_LLM_PROVIDER=gemini
# AIRWISE_MODEL=gemini-2.5-flash
# AIRWISE_DISABLE_LLM=false
# AIRWISE_RATE_LIMIT=30
