# Copy to .env (never commit .env). Without any key AirWise runs in rule-based mode.
# Tip (Windows): add lines from the terminal to avoid Notepad issues, e.g.
#   echo ANTHROPIC_API_KEY=your-key>>.env

# Claude (recommended, verified live) — used automatically when set
ANTHROPIC_API_KEY=
# Optional second key: used if the primary is rejected, out of credits, rate-limited or down.
ANTHROPIC_API_KEY_BACKUP=

# Or Google Gemini (used when no Anthropic key is set)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

PORT=8080
# Optional tuning
# AIRWISE_LLM_PROVIDER=anthropic     # force a provider: anthropic | gemini
# AIRWISE_MODEL=claude-opus-5-5
# AIRWISE_AI_BUDGET_MS=12000
# AIRWISE_DISABLE_LLM=false
# AIRWISE_RATE_LIMIT=30
