{
  "name": "airwise",
  "version": "1.0.0",
  "description": "GenAI assistant that helps families navigate winter smog with personalised, low-emission routines and indoor air quality guidance.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.js\"",
    "check:ai": "node scripts/check-ai.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
